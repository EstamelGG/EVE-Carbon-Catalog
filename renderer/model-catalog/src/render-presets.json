{
  "defaults": {
    "exposure": 0.7,
    "reflection": 0.7,
    "bloom": 0.2,
    "sun": 1,
    "fill": 1,
    "f0": 1,
    "roughness": 1,
    "dirt": 1,
    "depthOfField": 1
  },
  "rules": [
    { "dna": "^[^:]*:[^:]*:(sansha|triglavian)(:|$)", "settings": { "f0": 2 } },
    { "dna": "^[^:]*:[^:]*:concord(:|$)", "settings": { "fill": 0.3 } },
    { "dna": "^[^:]*:[^:]*:soe(:|$)", "settings": { "fill": 0.5 } }
  ]
}
