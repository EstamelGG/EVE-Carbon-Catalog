{
  "name": "eve-carbon-renderer",
  "private": true,
  "scripts": {
    "build": "npm run build:viewer && npm run build:embed",
    "build:embed": "node scripts/build-embed.mjs",
    "build:viewer": "esbuild scripts/viewer-entry.js --bundle --minify --format=esm --outfile=dist/vendor/model-viewer-ao.min.js --legal-comments=linked",
    "check:origins": "node scripts/check-renderer-origins.mjs"
  },
  "dependencies": {
    "@google/model-viewer": "4.4.0",
    "@google/model-viewer-effects": "1.5.0",
    "postprocessing": "6.39.5",
    "three": "0.183.2"
  },
  "devDependencies": {
    "esbuild": "0.25.12"
  },
  "type": "module"
}
